<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Oberon" implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonFileType"
                  fieldName="INSTANCE" language="Oberon" extensions="mod"/>

        <lang.parserDefinition language="Oberon"
                               implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonParserDefinition"/>

        <lang.syntaxHighlighterFactory language="Oberon"
                                       implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonSyntaxHighlighterFactory"/>

        <lang.commenter language="Oberon"
                        implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonCommenter"/>

        <lang.psiStructureViewFactory language="Oberon"
                                      implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonStructureViewFactory"/>

        <lang.quoteHandler implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonQuoteHandler"
                           language="Oberon"/>

        <lang.braceMatcher language="Oberon"
                           implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonBraceMatcher"/>

        <completion.contributor language="Oberon"
                                implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonCompletionContributor"/>

        <lang.formatter language="Oberon"
                        implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonFormattingModelBuilder"/>

<!--        <codeStyleSettingsProvider-->
<!--                implementation="de.rholambdapi.o2a.intellij.lang.oberon22.OberonCodeStyleSettingsProvider"/>-->

        <langCodeStyleSettingsProvider
                implementation="de.rholambdapi.o2a.intellij.lang.oberon2.OberonLanguageCodeStyleSettingsProvider"/>

        <gotoSymbolContributor
                implementation="de.rholambdapi.o2a.intellij.lang.oberon2.OberonChooseModuleByNameContributor"/>

        <gotoSymbolContributor
                implementation="de.rholambdapi.o2a.intellij.lang.oberon2.OberonChooseTypeByNameContributor"/>

        <annotator language="Oberon" implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.ConstAnnotator"/>

        <annotator language="Oberon" implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.PredeclaredIdentifierAnnotator" />

        <lang.documentationProvider language="Oberon"
                                    implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonDocumentationProvider"/>

        <documentationActionProvider implementation="de.rholambdapi.o2a.intellij.lang.oberon2.OberonDocumentationActionProvider" />

        <codeInsight.typeInfo language="Oberon"
                              implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonExpressionTypeProvider"/>

        <codeInsight.inlayProvider language="Oberon"
                                   implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonInlayProvider"/>

        <lang.foldingBuilder language="Oberon"
                             implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonProcedureFoldingBuilder"/>

        <lang.foldingBuilder language="Oberon"
                             implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonImportSectionFoldingBuilder"/>

        <lang.foldingBuilder language="Oberon"
                             implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonVarSectionFoldingBuilder"/>

        <lang.foldingBuilder language="Oberon"
                             implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonHeaderCommentFoldingBuilder"/>

        <lang.foldingBuilder language="Oberon"
                             implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonConstSectionFoldingBuilder" />

        <lang.foldingBuilder language="Oberon"
                             implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonTypeSectionFoldingBuilder" />

        <lang.foldingBuilder language="Oberon"
                             implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonIfFoldingBuilder" />

        <lang.foldingBuilder language="Oberon"
                             implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonCaseFoldingBuilder" />

        <lang.foldingBuilder language="Oberon"
                             implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonLoopFoldingBuilder" />

        <lang.findUsagesProvider language="Oberon"
                                 implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonFindUsagesProvider" />

        <navbar implementation="de.rholambdapi.o2a.intellij.lang.oberon2.OberonStructureAwareNavBar" />

        <codeInsight.parameterNameHints language="Oberon"
                                        implementationClass="de.rholambdapi.o2a.intellij.lang.oberon2.OberonParameterNameHints" />

        <defaultLiveTemplates file="/liveTemplates/Oberon.xml" />

        <liveTemplateContext implementation="de.rholambdapi.o2a.intellij.lang.oberon2.liveTemplates.OberonContext"
                             contextId="Oberon"/>
    </extensions>
</idea-plugin>